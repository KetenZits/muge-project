      "css": ".ds-button-gold{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:0 16px;border:1px solid transparent;border-radius:calc(var(--radius,.9rem)*1.4);font:600 14px/20px Inter, Kanit, Arial, sans-serif;text-decoration:none;white-space:nowrap;cursor:pointer;transition:background-color 200ms,color 200ms,transform 200ms,box-shadow 200ms;background:var(--yellow,#fac334);color:#4c390c;}.ds-button-gold:hover{background:#eeb622;}.ds-button-gold:focus-visible{outline:3px solid var(--blue,#17468c);outline-offset:2px;border-color:var(--blue,#17468c);box-shadow:0 0 0 3px #17468c80}.ds-button-gold:active{transform:translateY(1px) scale(.98)}.ds-button-gold:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button-gold{transition-duration:.01ms}.ds-button-gold:active{transform:none}}"
    },
    {
      "name": "Labeled Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Application Field and inputClass, rather than the generated Input's smaller neutral defaults.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">University email</span><input class=\"ds-field-input\" type=\"email\" placeholder=\"you@university.ac.th\"></label>",
      "css": ".ds-field{display:block;font-family:Inter, Kanit, Arial, sans-serif;color:var(--ink,#17263c)}.ds-field-label{display:block;margin-bottom:8px;font-size:14px;line-height:20px;font-weight:600;color:#33445c}.ds-field-input{width:100%;min-height:44px;padding:0 16px;border:1px solid #8091a5;border-radius:calc(var(--radius,.9rem)*1.4);background:#fff;color:var(--ink,#17263c);font:400 14px/20px Inter, Kanit, Arial, sans-serif;outline:none;transition:border-color 150ms,box-shadow 150ms}.ds-field-input::placeholder{color:#617187}.ds-field-input:focus{border-color:var(--blue,#17468c);box-shadow:0 0 0 3px #17468c20}.ds-field-input:focus-visible{outline:3px solid var(--blue,#17468c);outline-offset:2px}.ds-field-error{display:block;margin-top:4px;font-size:12px;line-height:16px;color:oklch(.577 .245 27.325)}@media(prefers-reduced-motion:reduce){.ds-field-input{transition-duration:.01ms}}"
    },
    {
      "name": "Domain Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Existing white bordered domain card with responsive padding and the shared hover lift.",
      "html": "<article class=\"ds-domain-card\"><h3 class=\"ds-card-title\"><a class=\"ds-card-link\" href=\"#team\">Find teammates</a></h3><p class=\"ds-card-copy\">Meet students with the skills and interests your next project needs.</p></article>",
      "css": ".ds-domain-card{padding:20px;border:1px solid var(--line,#e5ebf2);border-radius:20px;background:#fff;color:var(--ink,#17263c);font-family:Inter, Kanit, Arial, sans-serif;transition:transform var(--motion-fast,160ms) var(--motion-ease-out,cubic-bezier(.22,1,.36,1))}.ds-domain-card:hover{transform:translateY(-3px)}.ds-card-title{margin:0;font-size:18px;line-height:28px;font-weight:700;letter-spacing:-.025em}.ds-card-link{color:inherit;text-decoration:none}.ds-card-link:hover{color:var(--blue,#17468c)}.ds-card-link:focus-visible{outline:3px solid var(--blue,#17468c);outline-offset:2px}.ds-card-copy{margin:12px 0 0;color:#66778c;font-size:13px;line-height:24px}@media(min-width:640px){.ds-domain-card{padding:24px}}@media(prefers-reduced-motion:reduce){.ds-domain-card{transition-duration:.01ms}.ds-domain-card:hover{transform:none}}"
    },
    {
      "name": "Topic and Status Chips",
      "kind": "chip",
      "refersTo": "chip-blue",
      "description": "Standalone topic links and the established semantic chip palette; application Tag additionally inherits Badge sizing.",
      "html": "<div class=\"ds-chip-row\"><a class=\"ds-chip ds-chip-blue\" href=\"#ai\">#AI</a><span class=\"ds-chip ds-chip-neutral\">React</span><span class=\"ds-chip ds-chip-gold\">Competition</span><span class=\"ds-chip ds-chip-green\">Open</span><span class=\"ds-chip ds-chip-rose\">Status</span></div>",
      "css": ".ds-chip-row{display:flex;flex-wrap:wrap;gap:8px;font-family:Inter, Kanit, Arial, sans-serif}.ds-chip{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;border-radius:999px;font-size:12px;line-height:16px;font-weight:600;max-width:100%;white-space:normal;overflow-wrap:anywhere;text-decoration:none}.ds-chip-neutral{background:#f0f4f9;color:#53647c}.ds-chip-blue{background:#eaf1fc;color:var(--blue,#17468c)}.ds-chip-gold{background:#fbf3da;color:#765514}.ds-chip-green{background:#e8f6ef;color:#19694b}.ds-chip-rose{background:#fdf0ef;color:#9b443e}a.ds-chip-blue:hover{background:#dceafb}a.ds-chip:focus-visible{outline:3px solid var(--blue,#17468c);outline-offset:2px}"
    },
    {
      "name": "Desktop Navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Sidebar link rows with explicit current-page semantics, tinted active state, and keyboard focus.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Design preview navigation\"><a class=\"ds-nav-link\" href=\"#home\" aria-current=\"page\">Home</a><a class=\"ds-nav-link\" href=\"#discover\">Discover</a></nav>",
      "css": ".ds-nav{display:grid;gap:4px;font-family:Inter, Kanit, Arial, sans-serif}.ds-nav-link{display:flex;align-items:center;gap:12px;min-height:44px;padding:0 12px;border-radius:calc(var(--radius,.9rem)*1.4);color:#617187;font-size:14px;line-height:19.5px;font-weight:600;text-decoration:none;transition:background-color 150ms,color 150ms}.ds-nav-link[aria-current=page]{background:#eaf1fc;color:var(--blue,#17468c)}.ds-nav-link:hover{background:var(--soft,#f5f8fc);color:var(--blue,#17468c)}.ds-nav-link[aria-current=page]:hover{background:#eaf1fc}.ds-nav-link:focus-visible{outline:3px solid var(--blue,#17468c);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition-duration:.01ms}}"
    },
    {
      "name": "Segmented View Selector",
      "kind": "custom",
      "refersTo": "segmented-active",
      "description": "Existing feed-view selector; the static preview exposes the selected state without recreating application logic.",
      "html": "<div class=\"ds-segmented\"><button type=\"button\" class=\"ds-segment\" aria-pressed=\"true\">All posts</button><button type=\"button\" class=\"ds-segment\" aria-pressed=\"false\">Following</button><button type=\"button\" class=\"ds-segment\" aria-pressed=\"false\">Latest</button></div>",
      "css": ".ds-segmented{display:flex;max-width:100%;gap:4px;overflow-x:auto;padding:4px;border:1px solid #e5ecf3;border-radius:calc(var(--radius,.9rem)*1.4);background:#fff;font-family:Inter, Kanit, Arial, sans-serif}.ds-segment{min-height:44px;flex-shrink:0;padding:8px 16px;border:0;border-radius:var(--radius,.9rem);background:transparent;color:#617187;font:600 14px/20px Inter, Kanit, Arial, sans-serif;cursor:pointer;transition:background-color 150ms,color 150ms,transform 160ms}.ds-segment[aria-pressed=true]{background:var(--blue,#17468c);color:#fff}.ds-segment[aria-pressed=false]:hover{background:#f4f7fb}.ds-segment:focus-visible{outline:3px solid var(--blue,#17468c);outline-offset:2px}.ds-segment:active{transform:scale(.97)}@media(prefers-reduced-motion:reduce){.ds-segment{transition-duration:.01ms}.ds-segment:active{transform:none}}"
    },
    {
      "name": "Initials Avatar",
      "kind": "custom",
      "refersTo": "avatar",
      "description": "Medium application avatar; user-specific background colors and other existing sizes remain data/component choices.",
      "html": "<span class=\"ds-avatar\" role=\"img\" aria-label=\"Tester\">T</span>",
      "css": ".ds-avatar{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:2px solid #fff;border-radius:50%;overflow:hidden;background:#e8edf3;color:var(--blue,#17468c);font:700 12px/16px Inter, Kanit, Arial, sans-serif;flex-shrink:0}"
    }
  ],
  "narrative": {
    "northStar": "The Campus Commons",
    "overview": "The Campus Commons is clear, welcoming, and purposeful: a shared space where students can scan people, conversations, and opportunities without a competing visual spectacle. University Blue provides a stable anchor; Gold and warm yellow add warmth, while white surfaces and a cool canvas keep the interface approachable.\n\nComponents are approachable and restrained: soft corners, clear states, and quiet surfaces. Depth comes from tonal layers with selective soft lift. Dense information belongs inside a readable hierarchy, with spacing and alignment doing the organizing before another container is added. These descriptions name the existing interface; they do not authorize a replacement visual world.",
    "keyCharacteristics": [
      "University Blue and Gold remain the identity anchors.",
      "White content surfaces sit on a cool, pale canvas.",
      "Rounded controls and fine borders provide a consistent, approachable form language.",
      "Semantic tints and explicit labels distinguish categories and states.",
      "Short transitions, reduced-motion alternatives, and responsive navigation support everyday use."
    ],
    "rules": [
      {
        "name": "The Brand Anchor Rule",
        "body": "Use University Blue for core actions and active navigation. Keep Gold and warm yellow in their established accent roles; semantic status colors support meaning rather than replacing the brand.",
        "section": "colors"
      },
      {
        "name": "The Script Support Rule",
        "body": "Keep the locally bundled Inter and Kanit families available together. Preserve Thai text support whenever typography changes.",
        "section": "typography"
      },
      {
        "name": "The Selective Lift Rule",
        "body": "Organize ordinary content through surface tone, borders, and spacing. Reserve stronger shadows for existing action emphasis and overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the application wrappers and domain components before reaching for unmodified library defaults.",
      "Do retain University Blue and Gold while using semantic tints with readable text or icons.",
      "Do simplify grouping through spacing, headings, and alignment before adding another card.",
      "Do preserve keyboard focus, explicit labels, selected-state semantics, and reduced-motion behavior.",
      "Do check actual text contrast and rendering performance when refining existing screens.",
      "Do respect the customized radius scale, responsive navigation, and bottom-navigation clearance."
    ],
    "donts": [
      "Don't replace the existing interface or its brand during a documentation or narrow refinement task.",
      "Don't use color alone to communicate a category, selection, error, or status.",
      "Don't treat small, pale metadata or decorative uppercase labels as approved defaults for new content.",
      "Don't promote the inherited dialog width interaction or incomplete dark styles into system-wide rules.",
      "Don't add unnecessary nested cards, heavy resting shadows, or persistent decorative motion to ordinary app content."
    ]
  }
}
